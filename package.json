{
  "name": "can-optimizer",
  "version": "1.0.0",
  "private": true,
  "description": "CanOptimizer — Multivariable Calculus Lagrange Multipliers Web App (MTH-111, Salim Habib University)",
  "scripts": {
    "sync:solver": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('lib/python/solver.py','public/solver.py');\"",
    "predev": "npm run sync:solver",
    "dev": "next dev",
    "prebuild": "npm run sync:solver",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "katex": "^0.16.21",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "plotly.js-dist-min": "^3.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
